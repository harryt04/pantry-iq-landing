# Copy this file to .env.local and fill in real values for local
# development. Never commit .env.local — it is gitignored.

# --- Database (docker-compose Postgres; see docker-compose.yml) ---
POSTGRES_USER=pantryiq
POSTGRES_PASSWORD=pantryiq
POSTGRES_DB=pantryiq
DATABASE_URL=postgresql://pantryiq:pantryiq@localhost:5433/pantryiq

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-generated-secret
BETTER_AUTH_URL=http://localhost:3000

# --- Connector credentials ---
# Generate with: openssl rand -base64 32
CONNECTOR_CREDENTIAL_KEY=replace-with-a-separate-generated-secret

# --- Square connector (INT-03) ---
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=http://localhost:3000/api/connectors/square/webhook
# Leave unset for production; use the sandbox host for local connector tests.
# SQUARE_API_BASE_URL=https://connect.squareupsandbox.com

# --- Toast connector (INT-04) ---
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_EXTERNAL_ID=
TOAST_WEBHOOK_SECRET=
TOAST_WEBHOOK_URL=http://localhost:3000/api/connectors/toast/webhook
# Leave unset for production; use the Toast sandbox host for local connector tests.
# TOAST_API_BASE_URL=https://toast-api-server

# --- QuickBooks connector (INT-05) ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_VERIFIER_TOKEN=
QUICKBOOKS_CURRENCY_CODE=USD
# Choose explicitly: exclude rejects tax-inclusive bills; include requires
# tax-inclusive bills and uses their tax-inclusive line amounts.
QUICKBOOKS_TAX_MODE=exclude
# Leave unset for production; use the QuickBooks sandbox host for local tests.
# QUICKBOOKS_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com
# QUICKBOOKS_OAUTH_BASE_URL=https://oauth.platform.intuit.com

# --- Object storage (S3-compatible: Cloudflare R2 or Tigris) ---
# Not required until ING-02. Left here so the example file stays the
# single source of truth for every variable the app reads.
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=0

# --- Transactional email (Resend or equivalent) ---
# Not required until password reset is exercised end to end.
# RESEND_API_KEY=

# --- LLM access (Vercel AI SDK provider) ---
# Not required until CHT-02.
# ANTHROPIC_API_KEY=

# --- Analytics (PostHog) ---
# Only initialized in production; safe to leave blank for local dev.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
